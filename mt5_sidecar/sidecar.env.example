# Copy to sidecar.env next to server.py (or point MT5_SIDECAR_ENV_FILE at it).
# Values already in the process environment win over this file.

# Shared secret. Must match the connection's secret_env value in the app's
# BROKER_CONNECTIONS. At least 24 characters; required unless HOST is loopback.
MT5_BRIDGE_SECRET=CHANGE_ME

# Where the broker service reaches this sidecar.
MT5_SIDECAR_HOST=0.0.0.0
MT5_SIDECAR_PORT=9100

# Terminal. With a path the sidecar starts the terminal itself and restarts it
# if it dies. Login fields are optional when the terminal is already logged in.
MT5_TERMINAL_PATH=C:\MT5-A\terminal64.exe
MT5_PORTABLE=true
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# The trade server's time zone. Most retail MT5 brokers run on GMT+2/GMT+3
# (New York close), which is Europe/Athens. Check with the clock test in README.
MT5_SERVER_TZ=Europe/Athens

# Tag for this sidecar's orders, and the slippage accepted on market orders.
MT5_MAGIC=61000
MT5_DEVIATION_POINTS=20

# Orders on a real-money account are refused unless this is true.
MT5_ALLOW_REAL=false
