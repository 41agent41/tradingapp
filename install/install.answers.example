# TradingApp installer answers. Copy to /etc/tradingapp/install.answers on
# the app host and `chmod 600` it: the installer refuses a file other users can
# read, because it holds credentials.
#
#   install -d -m 700 /etc/tradingapp
#   install -m 600 install/install.answers.example /etc/tradingapp/install.answers
#
# Format: KEY=VALUE, one per line, `#` comments. Values may be wrapped in
# single or double quotes; a value cannot contain a single quote. The file is
# parsed, never executed.
#
# Two kinds of key:
#   INSTALL_*  settings for the installer itself
#   anything else is written verbatim into the app's .env (see .env.example
#   for every key and what it does). Leave a key out to keep .env's value.
#
# What the installer fills in by itself, so do NOT invent values for these:
#   SESSION_SECRET, API_TOKEN, BROKER_SERVICE_TOKEN, REDIS_PASSWORD, and
#   POSTGRES_PASSWORD with the bundled database: random, generated once.
#   APP_PASSWORD: generated if you leave it out (read it from .env afterwards).
#   SERVER_IP and the URLs derived from it: detected.
#   The secret of every MT5 connection in BROKER_CONNECTIONS: generated, then
#   copied onto the sidecar (AGENT_INSTALL_RUNBOOK.md, Phase B2).
#
# What it refuses (exit code 3): anything that would let an order reach a
# real-money account. LIVE_TRADING_ENABLED and SYSTEMATIC_EXECUTION_ENABLED
# must stay false, ALPACA_PAPER true, OANDA_ENVIRONMENT practice, IB_PORT not
# a live socket, and every BROKER_CONNECTIONS entry account_mode "paper".

# ---------------------------------------------------------------------------
# Installer settings (defaults shown)
# ---------------------------------------------------------------------------
#INSTALL_DIR=/opt/tradingapp
#INSTALL_USER=tradingapp
#INSTALL_REPO_URL=https://github.com/41agent41/tradingapp.git
#INSTALL_REF=master
# bundled: TimescaleDB as a container on this host (docker-compose.db.yml).
# external: an existing PostgreSQL + TimescaleDB, e.g. the database container
#           of PROXMOX_DEPLOYMENT.md §5. Needs POSTGRES_HOST and
#           POSTGRES_PASSWORD below, and the role, database and timescaledb
#           extension created there first (§5.3).
INSTALL_DB_MODE=bundled
# Seconds to wait for the stack to report healthy after a build.
#INSTALL_HEALTH_TIMEOUT=900
# Only the operator may set this: lets a re-run touch a host where a human has
# since turned LIVE_TRADING_ENABLED on. The installer still never turns it on.
#INSTALL_ALLOW_EXISTING_LIVE=yes

# ---------------------------------------------------------------------------
# Host (optional: detected from the default route when left out)
# ---------------------------------------------------------------------------
#SERVER_IP=10.7.3.20
# Behind nginx/TLS (PROXMOX_DEPLOYMENT.md §10), set the public origin instead:
#CORS_ORIGINS=https://trading.example.com

# ---------------------------------------------------------------------------
# Browser login (optional: generated when left out)
# ---------------------------------------------------------------------------
#APP_PASSWORD=

# ---------------------------------------------------------------------------
# External database (INSTALL_DB_MODE=external only)
# ---------------------------------------------------------------------------
#POSTGRES_HOST=10.7.3.21
#POSTGRES_PORT=5432
#POSTGRES_USER=tradingapp
#POSTGRES_DB=tradingapp
#POSTGRES_PASSWORD=
# false on a private bridge, true when the database requires TLS.
#POSTGRES_SSL=false

# ---------------------------------------------------------------------------
# Brokers (all optional; with none the app runs with no venue)
# ---------------------------------------------------------------------------
# IB Gateway logged in to a PAPER account (PROXMOX_DEPLOYMENT.md §6).
#IB_HOST=10.7.3.22
#IB_PORT=4002

# MT5 / Alpaca / OANDA connections, one JSON line. Every account_mode must be
# "paper". Secrets are named, not inlined: an MT5 secret_env is generated for
# you; Alpaca key_env/secret_key_env and OANDA token_env/account_env must be
# given below with the values the operator supplies.
#BROKER_CONNECTIONS='[{"id":"broker-a-demo","platform":"mt5","url":"http://10.7.3.23:9100","secret_env":"MT5_SECRET_A","account_mode":"paper","currency":"USD","default":true}]'
#PORTFOLIO_BASE_CURRENCY=USD
#DEFAULT_BROKER=mt5

# Alpaca paper keys / OANDA practice token, from the operator:
#ALPACA_KEY_A=
#ALPACA_SECRET_A=
#OANDA_TOKEN_A=
#OANDA_ACCOUNT_A=

# ---------------------------------------------------------------------------
# Alerting and the dead-man's switch (from the operator; strongly recommended)
# ---------------------------------------------------------------------------
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
#HEARTBEAT_URL=https://hc-ping.com/<uuid>
#HEARTBEAT_FAIL_URL=https://hc-ping.com/<uuid>/fail

# ---------------------------------------------------------------------------
# Paper-stage switches (safe to set at install; see PAPER_DEPLOYMENT_RUNBOOK.md)
# ---------------------------------------------------------------------------
#EXECUTIONS_SYNC_ENABLED=false
#SYSTEMATIC_ENABLED=false
#KILL_SWITCH_ACTION=notify
#TRADING_DAY_TIMEZONE=UTC
