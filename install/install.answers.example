# TradingApp installer answers. Copy to /etc/tradingapp/install.answers on
# the app host and `chmod 600` it: the installer refuses a file other users can
# read, because it can hold credentials.
#
#   install -d -m 700 /etc/tradingapp
#   install -m 600 install/install.answers.example /etc/tradingapp/install.answers
#
# Format: KEY=VALUE, one per line, `#` comments. Values may be wrapped in
# single or double quotes. The file is parsed, never executed.
#
# A fresh install needs nothing here at all: every line is optional.
#
# Three kinds of key:
#   INSTALL_*   settings for the installer itself
#   POSTGRES_*  the database (only for INSTALL_DB_MODE=external); these, and
#               SETTINGS_ENCRYPTION_KEY, are all .env holds
#   anything else is an app setting (as on the Settings page). It is stored
#   in the app's database once the stack is up, and not left in .env.
#
# What the installer makes by itself, so do NOT invent values for these: the
# encryption key, the bundled database's password, and the broker service
# token and Redis password (kept in a Docker volume, not in .env). The login
# password is chosen on the app's first-run screen, with the setup code from
# `./tradingapp.sh setup-code`.
#
# Brokers are NOT set here. They are added in the app (Settings >
# Connections), which tests each one as it is saved. The installer refuses
# broker keys (IB_HOST, BROKER_CONNECTIONS, OANDA_*, ALPACA_*, MT5_*).
#
# What it refuses (exit code 3): LIVE_TRADING_ENABLED or
# SYSTEMATIC_EXECUTION_ENABLED set to anything but false.

# ---------------------------------------------------------------------------
# Installer settings (defaults shown)
# ---------------------------------------------------------------------------
#INSTALL_DIR=/opt/tradingapp
#INSTALL_USER=tradingapp
#INSTALL_REPO_URL=https://github.com/41agent41/tradingapp.git
#INSTALL_REF=master
# bundled: TimescaleDB as a container on this host (docker-compose.db.yml).
# external: an existing PostgreSQL + TimescaleDB, e.g. the database server
#           of docs/INSTALL.md step 1. Needs POSTGRES_HOST and
#           POSTGRES_PASSWORD below, and the role, database and timescaledb
#           extension created there first (step 1.3).
#INSTALL_DB_MODE=bundled
# Seconds to wait for the stack to report ready after a build.
#INSTALL_HEALTH_TIMEOUT=900
# Only the operator may set this: lets a re-run touch a host where a human has
# since turned LIVE_TRADING_ENABLED on in .env. The installer never turns it on.
#INSTALL_ALLOW_EXISTING_LIVE=yes
# This host's address, when the default route does not give the right one
# (only used for the preflight check and the report).
#SERVER_IP=<this server's address>

# ---------------------------------------------------------------------------
# External database (INSTALL_DB_MODE=external only)
# ---------------------------------------------------------------------------
#POSTGRES_HOST=<the database server's address>
#POSTGRES_PORT=5432
#POSTGRES_USER=tradingapp
#POSTGRES_DB=tradingapp
#POSTGRES_PASSWORD=
# false on a private bridge, true when the database requires TLS.
#POSTGRES_SSL=false

# A rebuild that keeps an existing database needs the key it was opened with
# (`./tradingapp.sh backup-key` on the old host). Leave out on a fresh install.
#SETTINGS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# App settings (optional; each can be set on the Settings page instead)
# ---------------------------------------------------------------------------
# Behind a TLS reverse proxy (docs/INSTALL.md step 7), the public origin:
#CORS_ORIGINS=https://trading.example.com

# Alerting and the dead-man's switch (from the operator; strongly recommended)
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
#HEARTBEAT_URL=https://hc-ping.com/<uuid>
#HEARTBEAT_FAIL_URL=https://hc-ping.com/<uuid>/fail

# Paper-stage switches (see docs/PAPER_TRADING.md)
#EXECUTIONS_SYNC_ENABLED=false
#SYSTEMATIC_ENABLED=false
#KILL_SWITCH_ACTION=notify
#TRADING_DAY_TIMEZONE=UTC
