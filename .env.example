# TradingApp .env: only what the app needs before it can reach its database.
#
# You do not need to write this file: `./tradingapp.sh install` creates it,
# generates the secrets and never replaces them on a re-run. It is here to
# show what the file holds. Everything else (brokers, risk limits, alerts,
# schedules, what data to collect, logins) is set in the app, on the Settings
# page, and kept in the database.
#
# Keep a copy of SETTINGS_ENCRYPTION_KEY off this host
# (`./tradingapp.sh backup-key`): a rebuild that keeps the database needs it.

# How the backend reaches PostgreSQL + TimescaleDB. With the bundled database
# (the default) install fills these in: the host is the database container's
# address on the stack's network, and the password is generated.
POSTGRES_HOST=172.20.0.20
POSTGRES_PORT=5432
POSTGRES_USER=tradingapp
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=tradingapp
# true when an external database requires TLS.
POSTGRES_SSL=false

# Opens the secrets stored in the database (broker credentials, secret
# settings). 64 hex characters: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=CHANGE_ME

# ---------------------------------------------------------------------------
# Optional overrides. None is needed; each one, when set, wins over the app.
# ---------------------------------------------------------------------------
# Ports published on the host (defaults shown).
# FRONTEND_PORT=3000
# BACKEND_PORT=4000
# BROKER_SERVICE_PORT=8000
#
# The way back in when the login password is forgotten: set it here and run
# `./tradingapp.sh restart`. While set, it cannot be changed in the app.
# APP_PASSWORD=
#
# Any setting on the Settings page can be pinned here by its key (shown
# there), e.g. LIVE_TRADING_ENABLED=false. The page then shows it as locked.
# `./tradingapp.sh settings-import` moves such lines into the app.
