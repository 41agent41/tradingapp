# ============================================================================
# TradingApp Environment Configuration — EXAMPLE / TEMPLATE
# ----------------------------------------------------------------------------
# Copy this file to `.env` at the repo root and fill in real values for your
# deployment. `.env` is git-ignored on purpose — never commit secrets.
#
#   cp .env.example .env
#   $EDITOR .env
#
# The single management script `./tradingapp.sh` can also generate a baseline
# `.env` for you (`./tradingapp.sh setup` / `./tradingapp.sh config`), but it
# uses its own opinionated defaults; copying this file gives you the full
# documented set of keys.
#
# Generate fresh secrets for the JWT_/SESSION_ values, for example:
#   openssl rand -hex 32
# ============================================================================


# ---------------------------------------------------------------------------
# SERVER / NETWORK
# ---------------------------------------------------------------------------
# IP (or hostname) of the host running the Docker stack. This is the address
# end users put in their browser. It is interpolated into the public URLs
# baked into the frontend bundle at build time, so changing it requires a
# `./tradingapp.sh redeploy`.
NODE_ENV=production
ENVIRONMENT=production
SERVER_IP=YOUR_SERVER_IP
TZ=UTC


# ---------------------------------------------------------------------------
# FRONTEND (Next.js)
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000
FRONTEND_HOST=0.0.0.0
# The frontend is built with this URL embedded; it must be reachable from
# every browser that will use the app.
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:4000


# ---------------------------------------------------------------------------
# BACKEND (Express)
# ---------------------------------------------------------------------------
BACKEND_PORT=4000
BACKEND_HOST=0.0.0.0
# Comma-separated list of origins allowed by CORS. Must include the frontend
# origin that browsers actually use.
CORS_ORIGINS=http://YOUR_SERVER_IP:3000


# ---------------------------------------------------------------------------
# IB SERVICE (FastAPI + ibapi)
# ---------------------------------------------------------------------------
BROKER_SERVICE_PORT=8000
BROKER_SERVICE_HOST=0.0.0.0
# IP / hostname of the machine running IB Gateway or TWS. Use
# `host.docker.internal` when IB Gateway runs on the same host as Docker.
IB_HOST=YOUR_IB_GATEWAY_IP
# 4002 = paper trading socket, 4001 = live trading socket (defaults).
IB_PORT=4002
# Unique client id per connecting process. Increase if you run multiple
# replicas, otherwise IB Gateway will refuse the second connection.
IB_CLIENT_ID=1
IB_TIMEOUT=30
IB_CORS_ORIGINS=http://YOUR_SERVER_IP:3000

# IB / data timezone handling — leave these unless you know you need to
# change them. The IB service normalises everything to UTC seconds.
IB_TIMEZONE=UTC
EXPECTED_TIMESTAMP_FORMAT=unix_seconds
DATA_TIMEZONE=UTC
IB_DATE_FORMAT=YYYYMMDD
IB_TIME_FORMAT=HHMMSS
IB_FORMAT_DATE=2


# ---------------------------------------------------------------------------
# EXTERNAL POSTGRES / TIMESCALEDB
# ---------------------------------------------------------------------------
# The Docker compose file does NOT provision Postgres — point these at a
# reachable external database. The canonical schema lives at
# `backend/src/database/timescaledb-schema.sql`.
POSTGRES_HOST=YOUR_EXTERNAL_DB_HOST
POSTGRES_PORT=5432
POSTGRES_USER=tradingapp
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=tradingapp
# Set to `true` for managed services (AWS RDS, Timescale Cloud, etc.).
POSTGRES_SSL=true


# ---------------------------------------------------------------------------
# REDIS
# ---------------------------------------------------------------------------
# Redis is provisioned by docker-compose and wired into the backend as a
# read-through cache (Phase 2) and as the real-time tick bus between the IB
# service and the Socket.IO bridge (Phase 4).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# Set to "false" to disable the cache entirely (every request talks to
# the IB service / database directly).
REDIS_ENABLED=true

# Cache TTLs in seconds. The realtime cache is intentionally short so
# quotes stay live; the search cache absorbs typing-driven duplicates.
CACHE_TTL_REALTIME=2
CACHE_TTL_SEARCH=300

# Phase 4 — real-time streaming pipeline. When STREAMING_ENABLED=false
# the backend's Socket.IO bridge will not connect to Redis and will not
# fan ticks out (the IB service still publishes them; clients just see
# nothing). Useful when you don't have Redis available and want the
# REST polling fallback to keep working.
STREAMING_ENABLED=true

# Phase 5 — automated backfill scheduler. When BACKFILL_ENABLED=true the
# backend periodically tops up the database with recent bars for every
# enabled `auto_collect` row in the `data_collection_config` table, by
# calling the IB service and upserting the result. It is OFF by default
# because it makes live IB requests on a timer; turn it on only once you
# have populated data_collection_config (see DEPLOYMENT.md).
BACKFILL_ENABLED=false
# How often the scheduler ticks. Each row is additionally rate-limited by
# its own collection_interval_minutes, so a fast global tick won't refetch
# slow-moving daily data every time.
BACKFILL_INTERVAL_MINUTES=15
# Window fetched per run (any IB period: 1D, 5D, 1M, ...). Overlap is fine —
# bars upsert by (contract, timeframe, timestamp).
BACKFILL_PERIOD=5D
# Delay before the first run so it doesn't fire mid-startup (milliseconds).
BACKFILL_INITIAL_DELAY_MS=30000


# ---------------------------------------------------------------------------
# SYSTEMATIC STRATEGIES (Systematic Trading Phase 2 — runner; Phase 3 — execution)
# ---------------------------------------------------------------------------
# When SYSTEMATIC_ENABLED=true the backend runs a timer that, for every
# `status='running'` strategy_runs row, pulls the latest closed bars, asks the
# IB service to evaluate the rule-set (POST /strategies/evaluate) and records +
# broadcasts the resulting signal. It is OFF by default. With ONLY this flag on
# it is strictly SIGNAL-ONLY — it never places an order. Definitions/runs can
# still be created via /api/strategies while this is off; they simply aren't
# evaluated until enabled.
SYSTEMATIC_ENABLED=false
# How often the runner evaluates every running strategy (seconds, min 5).
SYSTEMATIC_INTERVAL_SECONDS=60
# Delay before the first evaluation so it doesn't fire mid-startup (ms).
SYSTEMATIC_INITIAL_DELAY_MS=15000

# --- Phase 3 / A3: auto-execution (paper) ----------------------------------
# Master switch for the systematic ENGINE placing orders. Distinct from
# LIVE_TRADING_ENABLED: this gate turns the engine on; LIVE_TRADING_ENABLED
# still independently gates live (vs paper) orders. Both default OFF, so a run
# only auto-trades once you set SYSTEMATIC_EXECUTION_ENABLED=true — and only on
# a PAPER account until LIVE_TRADING_ENABLED=true as well. Flipping this back to
# false is the global kill switch: the engine refuses new orders within one
# evaluation cycle. Actionable signals are submitted through the SAME audited
# /api/orders path, inheriting the fat-finger caps, the position-limit guard
# and order_audit.
SYSTEMATIC_EXECUTION_ENABLED=false
# Global backstop on engine-placed orders per calendar day, across ALL runs
# (a last-resort circuit breaker on top of each run's own max_orders_per_day).
# 0 (the default) disables the global cap.
SYSTEMATIC_MAX_ORDERS_PER_DAY=0

# --- Promotion gate: backtest, then paper, then live ---------------------------
# A definition is frozen once created. Starting a run or deploying it needs:
#   paper: a backtest of that definition, on data from its holdout start date,
#          with at least PROMOTION_MIN_TRADES trades, positive expectancy and a
#          max drawdown under PROMOTION_MAX_BACKTEST_DRAWDOWN_PCT;
#   live:  all of that, plus a paper run of the same definition lasting at
#          least PROMOTION_MIN_PAPER_DAYS whose realised drawdown (as % of the
#          paper account's equity) is no worse than
#          PROMOTION_PAPER_DRAWDOWN_RATIO x the backtest's.
# GET /api/strategies/definitions/:id/promotion explains what is missing.
# PROMOTION_MIN_TRADES=30
# PROMOTION_MAX_BACKTEST_DRAWDOWN_PCT=20
# PROMOTION_MIN_PAPER_DAYS=28
# PROMOTION_PAPER_DRAWDOWN_RATIO=1.5
# "off" skips the backtest check for PAPER runs only (smoke tests). Live is
# always gated.
# PROMOTION_PAPER_GATE=enforce

# --- Per-run risk.max_daily_loss -------------------------------------------
# A run's rule-set may declare `risk.max_daily_loss` (an amount, in the
# account currency). Once the run's REALISED P&L for the calendar day reaches
# -max_daily_loss, the engine stops opening NEW positions for that run. It
# does NOT block exits — blocking those would strand the position in the very
# trade that caused the loss.
#
# The cap is measured against fills, so it needs EXECUTIONS_SYNC_ENABLED=true
# (below). With the fills feed off, a declared max_daily_loss fails CLOSED:
# the run places nothing rather than trading against a cap it cannot evaluate.


# ---------------------------------------------------------------------------
# EXECUTIONS (FILLS) SYNC
# ---------------------------------------------------------------------------
# When EXECUTIONS_SYNC_ENABLED=true the backend periodically pulls each active
# venue's execution reports (GET /account/executions on the broker service)
# into the `order_executions` table. This is what makes positions and P&L come
# from what actually TRADED rather than from what the app SUBMITTED — the
# submitted-order estimate in order_audit silently disagrees with the account
# on a partial fill, on a rejection that lands after the acknowledgement, and
# on any trade placed outside the app.
#
# Turn it on if you use `risk.max_daily_loss` (it is the P&L source), or if you
# want /api/account/executions and /api/account/pnl to report anything. OFF by
# default because it makes live venue requests on a timer.
EXECUTIONS_SYNC_ENABLED=false
# How often to poll each venue (seconds, min 15).
EXECUTIONS_SYNC_INTERVAL_SECONDS=120
# How far back each poll reaches (days, 1-30). The window overlaps on purpose:
# a fill can be reported late, and IB delivers a fill's commission on a
# separate callback from the fill itself, so re-reading is how those converge.
# Re-delivered rows upsert on (broker, exec_id) and never duplicate.
EXECUTIONS_SYNC_LOOKBACK_DAYS=2
# Delay before the first poll so it doesn't fire mid-startup (milliseconds).
EXECUTIONS_SYNC_INITIAL_DELAY_MS=20000
# Account mode stamped on a fill with no order of ours behind it (a trade
# placed by hand at the venue). Fills that DO match an order take that order's
# mode instead, so this only covers the unattributed case.
EXECUTIONS_DEFAULT_ACCOUNT_MODE=paper


# ---------------------------------------------------------------------------
# LIVE TRADING (Tier 4 — order management)
# ---------------------------------------------------------------------------
# Master switch for the order-placement path (POST /api/orders →
# POST /orders on the IB service). When false (the default), paper-account
# orders are still accepted but any account_mode=live request is rejected
# with HTTP 403 by both the backend route AND the IB service handler.
#
# To enable live trading you MUST set this on BOTH services:
#   LIVE_TRADING_ENABLED=true
# Restart the backend and broker_service containers for the change to take
# effect (`./tradingapp.sh redeploy`).
LIVE_TRADING_ENABLED=false

# Fat-finger caps applied by the backend validator on every order. Defaults
# are deliberately conservative; raise them if your real-world order sizes
# exceed them. Both apply equally to paper and live orders.
ORDER_MAX_QUANTITY=100000
ORDER_MAX_PRICE=1000000

# Position-limit guard (opt-in). Caps the absolute NET signed exposure per
# (symbol, account_mode) implied by the order_audit log: a BUY adds and a
# SELL subtracts, and a new order whose projected net would exceed the cap is
# rejected with HTTP 422 before it reaches IB. 0 (the default) disables the
# guard. This is a SOFT guard built on submitted orders within the lookback
# window below — not authoritative IB fills — so treat it as runaway-order
# protection, not a hard risk limit.
ORDER_MAX_POSITION=0
# Only orders submitted within this many hours count toward the net, so
# long-expired DAY orders don't inflate it. Default 24.
ORDER_POSITION_LOOKBACK_HOURS=24

# Default execution venue (Systematic Trading B1) when an order or a strategy
# run doesn't name one. Instruments are broker-scoped and the net-exposure cap
# is keyed per (broker, symbol, account_mode), so exposure never nets across
# venues. 'ib' today; 'mt5' / 'alpaca' / 'oanda' are accepted but only served
# once their adapter is configured (see below). Must be one of:
# ib | mt5 | alpaca | oanda.
DEFAULT_BROKER=ib

# ---------------------------------------------------------------------------
# Alerting and the kill switch (Component E — E-5)
# ---------------------------------------------------------------------------
# Telegram, chosen for reachability: a bot token and an HTTPS call, against
# WhatsApp Business API approval or a Signal bridge process. Unset, alerting is
# simply off and everything else behaves the same.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
#
# Deduplication is not a nicety. These alerts fire from a loop that runs every
# bar, so an ongoing condition is true again 60 seconds later. A channel that
# repeats itself gets muted, and a muted channel is worse than none because it
# looks like coverage.
# ALERT_DEDUPE_SECONDS=3600
# ALERT_MAX_PER_HOUR=30

# The kill switch is DETECTION, not prevention. Everything evaluates at bar
# close, so it cannot stop price gapping through a stop — by the time it looks,
# the fill has happened. It notices, and (once escalated) stops the next thing
# going wrong.
#
#   notify  — alert only, no automated action. The default, and worth staying
#             on for a while: it runs against real conditions with zero blast
#             radius, so trigger accuracy can be judged from the alerts it
#             *would* have acted on.
#   halt    — a critical trigger also stops new entries on that connection
#             until it is resumed from the Fleet panel (E-6). Exits and stop
#             management keep running. Warnings never halt.
#   flatten — not implemented yet; the backend refuses to start with it.
# KILL_SWITCH_ACTION=notify

# How far past the in-force stop a fill must land to count as a gap, as a
# percentage of the stop price. 0 disables the check.
# KILL_SWITCH_STOP_GAP_TOLERANCE_PCT=25

# Absolute equity floor per connection; 0 disables.
# KILL_SWITCH_EQUITY_FLOOR=0

# ---------------------------------------------------------------------------
# Account- and fleet-level risk caps (Component C — C-4)
# ---------------------------------------------------------------------------
# These sit ALONGSIDE the per-run caps in a strategy's `risk` block, they do not
# replace them. A connection hosting several runs can breach an account-level
# limit while every individual run sits comfortably inside its own — and the
# account is the level a broker (or a prop firm) actually enforces at.
#
# Applies to every connection:
# CONNECTION_MAX_ORDERS_PER_DAY=20
# CONNECTION_MAX_DAILY_LOSS=500
#
# Per connection, overriding the above. The suffix is the connection label
# uppercased with non-alphanumerics replaced by underscores, so
# `mt5:pepperstone-live` becomes MT5_PEPPERSTONE_LIVE:
# CONNECTION_MAX_DAILY_LOSS__MT5_PEPPERSTONE_LIVE=1000
# CONNECTION_MAX_ORDERS_PER_DAY__MT5_PEPPERSTONE_LIVE=50
#
# CONNECTION_MAX_DAILY_LOSS above counts realised P&L from fills, so it misses
# an open position deep in the red. These two measure equity (balance plus
# floating P&L), which is what a broker or prop firm acts on. Both stop new
# entries only; exits and stops keep running. Same per-connection suffixes.
#   daily: equity below where it started the trading day
#   drawdown: equity below its high-water mark (reset it from the Fleet panel
#             after a withdrawal, which is a drop but not a loss)
# CONNECTION_MAX_DAILY_EQUITY_LOSS=300
# CONNECTION_MAX_DRAWDOWN=1000
#
# Prop-firm rules (R-P1), per account only, as JSON. Daily loss and max loss
# are computed the firm's way, and entries stop once the room left is within
# buffer_pct of the allowance, short of the firm's own limit:
#   daily_loss: {"pct": 5} or {"amount": 5000}, with "basis" balance (default),
#     equity, or higher (the higher of the two at the day's start)
#   max_loss: {"pct": 10} or {"amount": ...}, with "mode" static (below the
#     initial balance), trailing_equity or trailing_balance (below the highest
#     reached); a trailing floor stops at the initial balance unless
#     "lock_at_initial": false
#   buffer_pct: default 20
# Optional rules on *when* the account may trade (R-P2), entries only:
#   news_blackout: {"minutes_before": 2, "minutes_after": 2, "impact": ["High"]}
#     no entries around listed-impact news for either currency of the pair;
#     entries are refused while the calendar below cannot be read
#   weekend: {"no_entries_after": "fri 20:00", "resume": "mon 00:00"}, in
#     TRADING_DAY_TIMEZONE; a position still open in that window pages you
#   min_trading_days: {"days": 4, "start_date": "2026-10-01"}, days with a
#     fill since the start, shown on the Fleet panel (nothing is refused)
# The backend refuses to start with rules it cannot read.
# PROP_RULES__MT5_FTMO={"firm":"FTMO 100k","initial_balance":100000,"daily_loss":{"pct":5,"basis":"balance"},"max_loss":{"pct":10,"mode":"static"},"buffer_pct":20,"news_blackout":{"minutes_before":2,"minutes_after":2},"weekend":{"no_entries_after":"fri 20:00"}}
#
# The economic calendar for news blackouts: a JSON list of
# {title, country (a currency code), date, impact}. Default is the free weekly
# feed below. Refreshed every NEWS_CALENDAR_REFRESH_MINUTES (default 360);
# after NEWS_CALENDAR_MAX_AGE_HOURS (default 24) without a successful fetch it
# is stale and accounts with a news rule stop taking entries.
# NEWS_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
# NEWS_CALENDAR_REFRESH_MINUTES=360
# NEWS_CALENDAR_MAX_AGE_HOURS=24
#
# When the trading day rolls over, as an IANA zone. Match your broker's server
# (often Europe/Athens for UTC+2/+3 MT5 servers). Default UTC.
# TRADING_DAY_TIMEZONE=UTC
#
# Fleet-wide backstop. With one strategy across several accounts there is no
# diversification — every leg takes the same trade at the same moment, so the
# fleet's risk is N times one account's.
# PORTFOLIO_MAX_DAILY_LOSS=2000
#
# The denomination every connection is asserted to report. Aggregating mixed
# currencies produces a number that adds up and means nothing, so a mismatch
# makes the portfolio cap REFUSE rather than sum. Leave unset only if no
# portfolio cap is configured.
# PORTFOLIO_BASE_CURRENCY=USD
#
# Tolerance for the venue-vs-fills position check; fractional lot sizes never
# compare exactly.
# POSITION_RECONCILIATION_TOLERANCE=0.0001

# ---------------------------------------------------------------------------
# Fleet scheduling and staged deploy (Component C — C-3)
# ---------------------------------------------------------------------------
# How many connections the strategy runner evaluates concurrently. Runs within
# one connection stay sequential — one MT5 sidecar is one terminal — but a
# connection that is powered on and not answering must not stall the others.
# SYSTEMATIC_MAX_CONNECTION_CONCURRENCY=4

# Consecutive failures before a connection is skipped, and how long it is
# skipped for. Without this, an unresponsive sidecar costs its full timeout on
# every run, every tick.
# SYSTEMATIC_CONNECTION_BREAKER_THRESHOLD=3
# SYSTEMATIC_CONNECTION_BREAKER_COOLDOWN_SECONDS=300

# Staged deploy: a group's canary leg must evaluate cleanly for this long
# before its siblings start. Set it to span at least one bar of the slowest
# timeframe in the group, so "evaluated cleanly" means the leg produced a
# decision rather than merely starting without error. Per-deploy override:
# POST /api/strategies/definitions/:id/deploy { "settle_seconds": 900 }
# SYSTEMATIC_GROUP_CANARY_SETTLE_SECONDS=300

# ---------------------------------------------------------------------------
# Multi-account connections (Component C — C-1)
# ---------------------------------------------------------------------------
# The variables below each configure ONE account per platform. To run several
# accounts on the same platform — two MT5 brokers, a live and a demo terminal,
# a second IB login — use the connection manifest instead. It supersedes them
# all; setting both a manifest and a legacy variable is a startup error rather
# than a silent precedence rule, because guessing wrong routes orders to the
# wrong account.
#
# Topology only: secrets are referenced BY ENVIRONMENT-VARIABLE NAME and never
# appear in the manifest itself.
#
#   BROKER_CONNECTIONS=[
#     {"id":"pepperstone-live","platform":"mt5","url":"http://10.7.3.22:9100",
#      "secret_env":"MT5_SECRET_PEPPERSTONE","account_mode":"live",
#      "currency":"USD","default":true,"server_timezone":"Etc/GMT-2"},
#     {"id":"icmarkets-demo","platform":"mt5","url":"http://10.7.3.23:9100",
#      "secret_env":"MT5_SECRET_ICMARKETS","account_mode":"paper","currency":"USD"}
#   ]
#   MT5_SECRET_PEPPERSTONE=...
#   MT5_SECRET_ICMARKETS=...
#
# Or point at a file holding the same JSON (easier to review in git):
#   BROKER_CONNECTIONS_FILE=/etc/tradingapp/connections.json
#
# Per-connection fields:
#   id             account name; [a-z0-9_-], addressed as broker=mt5&account=<id>
#   platform       ib | mt5 | alpaca | oanda
#   account_mode   paper | live — a BINDING CONSTRAINT, not a default. A live
#                  order addressed to a connection declared paper is refused
#                  (HTTP 409), and vice versa.
#   default        exactly one per platform; what an unqualified broker=<p> means
#   currency       asserted against what the venue reports; a mismatch is refused
#   server_timezone  the broker's server clock, recorded for session handling
#   same_funds_as  another connection id reaching the SAME underlying money —
#                  e.g. a firm offering both its own API and an MT5 bridge.
#                  Nothing in either API reveals the overlap, so declare it or
#                  aggregate exposure double-counts it.
#   symbol_map     per-connection overrides, e.g. {"EURUSD":"EURUSD.a"}
#   account_info_from  (mt5 only) an oanda connection id whose REST API supplies
#                  this connection's balance, margin and positions, while orders
#                  still go through the MT5 sidecar. Implies same_funds_as; the
#                  two connections must declare the same currency.
#   MT5:    url + secret_env
#   Alpaca: key_env + secret_key_env
#   OANDA:  token_env + account_env
# BROKER_CONNECTIONS=
# BROKER_CONNECTIONS_FILE=

# MetaTrader 5 data + execution sidecar (Systematic Trading B2a/B2b). The
# MetaTrader5 package is Windows-only, so MT5 runs as a small HTTP service on a
# Windows host and the broker_service talks to it as a thin client. When set,
# source=mt5 / broker=mt5 become available (charts, quotes, ticks, orders route
# to this bridge); unset, mt5 stays a recognised-but-unavailable provider
# (HTTP 501). Example:
#   MT5_BRIDGE_URL=http://mt5-host:9100
# Single-account shorthand — synthesises the connection `mt5:default`.
# Deprecated in favour of BROKER_CONNECTIONS, not removed.
# MT5_BRIDGE_URL=

# Shared secret sent as the `X-MT5-Bridge-Secret` header on every request to
# MT5_BRIDGE_URL; the sidecar should reject requests missing it or presenting
# the wrong value. The sidecar contract otherwise has no auth story, so
# anything that can reach MT5_BRIDGE_URL can query positions/account and
# place, cancel, or modify orders on the MT5 account — set this (and implement
# the check on the sidecar) before relying on MT5 beyond a lab test. Only
# meaningful when MT5_BRIDGE_URL is set.
# MT5_BRIDGE_SECRET=

# Alpaca (equities/options, US). Unlike MT5 there's no sidecar host — Alpaca
# is a cloud REST API the broker_service calls directly, so only credentials
# are needed. When both are set, source=alpaca/broker=alpaca become available
# (charts, quotes, ticks, orders); unset, alpaca stays recognised-but-
# unavailable (HTTP 501).
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# Trade against Alpaca's paper endpoint (true) or live (false). Default true.
ALPACA_PAPER=true

# OANDA (FX/CFD). Also a cloud REST API — no sidecar host needed. When both
# are set, source=oanda/broker=oanda become available; unset, oanda stays
# recognised-but-unavailable (HTTP 501).
# OANDA_API_TOKEN=
# OANDA_ACCOUNT_ID=
# Practice (paper) or live OANDA environment. Default practice.
OANDA_ENVIRONMENT=practice
# Set to `oanda` to read mt5:default's account information (balance, margin,
# positions) from the OANDA REST API above while orders keep going through
# MT5_BRIDGE_URL — for an OANDA account traded via MT5. Needs MT5_BRIDGE_URL,
# OANDA_API_TOKEN and OANDA_ACCOUNT_ID; the manifest equivalent is
# `account_info_from`.
# MT5_ACCOUNT_INFO_SOURCE=

# IB Gateway sometimes takes a beat after placeOrder to flush the status
# callback. The IB-service handler sleeps this many seconds after each
# placeOrder so the client can read orderStatus before returning. Capped at
# 5s internally.
ORDER_PLACE_WAIT_SECONDS=3

# --- Order-endpoint authorization (RBAC + MFA) -----------------------------
# These harden the mutating order routes (create / cancel / modify) on top of
# login. Optional for paper trading, REQUIRED when LIVE_TRADING_ENABLED=true:
# the backend refuses to start with live trading on and either one unset.
# They apply to paper AND live orders alike once set.
#
# RBAC — trader role. A comma-separated allowlist of "trading tokens". When
# set, order-mutating requests must present a matching `X-Trading-Token`
# header (a credential distinct from API_TOKEN, so a read-only viewer holding
# only API_TOKEN cannot place orders). Empty (the default) disables the check.
#   TRADING_TOKENS=$(openssl rand -hex 24),$(openssl rand -hex 24)
TRADING_TOKENS=
#
# MFA — TOTP second factor. A base32 secret (as emitted by authenticator apps
# like Google Authenticator / Authy). When set, order-mutating requests must
# present a valid 6-digit `X-MFA-Code`. Generate one and add it to your
# authenticator app, then set the same secret here. Empty disables MFA.
#   ORDER_MFA_SECRET=JBSWY3DPEHPK3PXP
ORDER_MFA_SECRET=


# ---------------------------------------------------------------------------
# SECRETS
# ---------------------------------------------------------------------------
# REQUIRED in production. `./tradingapp.sh config` generates any of these that
# are missing or still CHANGE_ME; never commit real values. With
# NODE_ENV=production the backend refuses to start if one is missing, a
# template value, or too short.
#   openssl rand -hex 32
#
# APP_PASSWORD is the browser login (one user). The backend answers with an
# HttpOnly session cookie signed by SESSION_SECRET; rotating SESSION_SECRET
# signs every browser out. Nothing secret is compiled into the frontend.
APP_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME
# SESSION_TTL_HOURS=12
# Set when the app is served over HTTPS by a proxy that does not send
# X-Forwarded-Proto, so the session cookie is marked Secure.
# COOKIE_SECURE=false

# API_TOKEN is for scripts and curl: `Authorization: Bearer <token>`. It is
# never sent to the browser.
API_TOKEN=CHANGE_ME

# Shared secret between the backend and the broker service. The broker
# service can place orders, so it rejects any call without this header.
BROKER_SERVICE_TOKEN=CHANGE_ME


