{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "row",
      "title": "Backend (Express)",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "id": 100,
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Backend request rate (/s)",
      "description": "Requests per second served by the Express backend, by route. Source: http_request_duration_seconds_count from backend/src/services/metrics.ts.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 1, "w": 12, "h": 8 },
      "id": 1,
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_request_duration_seconds_count{service=\"backend\"}[5m]))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "type": "timeseries",
      "title": "Backend p95 latency (s)",
      "description": "p95 of http_request_duration_seconds, per route. Slow routes show up first here.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 1, "w": 12, "h": 8 },
      "id": 2,
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (route, le) (rate(http_request_duration_seconds_bucket{service=\"backend\"}[5m])))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "type": "timeseries",
      "title": "Backend errors (%) by route",
      "description": "Share of responses that returned 5xx, per route. The default colour scheme highlights anything above 1%.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 9, "w": 12, "h": 7 },
      "id": 3,
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (route) (rate(http_request_duration_seconds_count{service=\"backend\",status=~\"5..\"}[5m])) / clamp_min(sum by (route) (rate(http_request_duration_seconds_count{service=\"backend\"}[5m])), 0.001)",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "stat",
      "title": "Backtest runs persisted (rate /h)",
      "description": "Counter increments on every successful backtest_runs INSERT. Source: backtest_runs_persisted_total.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 9, "w": 6, "h": 7 },
      "id": 4,
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(backtest_runs_persisted_total[1h])) * 3600",
          "legendFormat": "runs/h"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 1 },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Backend RSS (MB)",
      "description": "process_resident_memory_bytes from prom-client's default collector.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 18, "y": 9, "w": 6, "h": 7 },
      "id": 5,
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{service=\"backend\"} / 1024 / 1024"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "decmbytes", "decimals": 0 },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      }
    },
    {
      "type": "row",
      "title": "IB Service (FastAPI)",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 1 },
      "id": 101,
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "IB service request rate (/s)",
      "description": "Source: prometheus_fastapi_instrumentator http_requests_total counter on each FastAPI handler.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 17, "w": 12, "h": 8 },
      "id": 6,
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (handler) (rate(http_requests_total{handler!~\"/metrics|/health\"}[5m]))",
          "legendFormat": "{{handler}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "type": "timeseries",
      "title": "IB service p95 latency (s)",
      "description": "p95 of the instrumentator's http_request_duration_seconds histogram. Slow IB Gateway round-trips dominate this.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 17, "w": 12, "h": 8 },
      "id": 7,
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (handler, le) (rate(http_request_duration_seconds_bucket{handler!~\"/metrics|/health\"}[5m])))",
          "legendFormat": "{{handler}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "type": "row",
      "title": "Process",
      "gridPos": { "x": 0, "y": 25, "w": 24, "h": 1 },
      "id": 102,
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "CPU usage (%)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 26, "w": 12, "h": 7 },
      "id": 8,
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_user_seconds_total{service=\"backend\"}[1m]) * 100",
          "legendFormat": "backend user%"
        },
        {
          "refId": "B",
          "expr": "rate(process_cpu_system_seconds_total{service=\"backend\"}[1m]) * 100",
          "legendFormat": "backend sys%"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "type": "timeseries",
      "title": "Event loop lag (s)",
      "description": "Backend only. From prom-client's default Node.js collector.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 26, "w": 12, "h": 7 },
      "id": 9,
      "targets": [
        {
          "refId": "A",
          "expr": "nodejs_eventloop_lag_seconds{service=\"backend\"}"
        },
        {
          "refId": "B",
          "expr": "nodejs_eventloop_lag_p99_seconds{service=\"backend\"}",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["tradingapp"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "TradingApp Overview",
  "uid": "tradingapp-overview",
  "version": 1,
  "weekStart": ""
}
