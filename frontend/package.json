{
  "name": "tradingapp-frontend",
  "version": "1.0.0",
  "description": "TradingApp Frontend",
  "private": true,
  "scripts": {
    "dev": "node server.js --dev",
    "build": "next build",
    "start": "node server.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"app/**/*.{ts,tsx,js,jsx,css,md,json}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,js,jsx,css,md,json}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "autoprefixer": "10.6.2",
    "lightweight-charts": "4.2.3",
    "next": "16.4.6",
    "postcss": "8.5.32",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io-client": "4.8.4",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "22.20.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "^25.0.1",
    "prettier": "3.9.6",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.12"
  }
}
